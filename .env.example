MAIL_ADDRESS=orders@example.ru
MAIL_PASSWORD=
# MAIL_USER defaults to MAIL_ADDRESS.
# MAIL_USER=
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_MAILBOX=INBOX
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
STATE_FILE=./data/state.json
# Токен API МойСклад (Bearer)
MOYSKLAD_TOKEN=
# Опционально: URL API МойСклад (по умолчанию https://api.moysklad.ru/api/remap/1.2)
# MOYSKLAD_API_URL=https://api.moysklad.ru/api/remap/1.2
# Опционально: JSON-массив разрешенных адресов отправителей (если не задан - обрабатываются все)
# ALLOWED_SENDERS=["partner1@example.ru","partner2@example.ru"]
# Optional: one notification when processing fails, without retries.
# ADMIN_ADDRESS=admin@example.ru
